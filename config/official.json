{
  "version": 1,
  "application": {
    "name": "oficina-estoque",
    "environment": "Production",
    "containerPort": 8080
  },
  "aws": {
    "namespaceParameter": "/oficina/infra/k8s/namespace",
    "instanceIdParameter": "/oficina/infra/k8s/instance-id",
    "ecrRepositoryParameter": "/oficina/infra/ecr/estoque",
    "regionFromWorkflow": true
  },
  "kubernetes": {
    "deploymentName": "oficina-estoque",
    "serviceName": "oficina-estoque",
    "containerName": "oficina-estoque",
    "migrationJobPrefix": "oficina-estoque-migration",
    "replicas": 1,
    "nodePort": 30081,
    "targetGroupArnParameter": "/oficina/infra/services/estoque/target-group-arn",
    "nodePortParameter": "/oficina/infra/services/estoque/node-port",
    "manifests": {
      "configMap": "k8s/configmap.yaml",
      "deployment": "k8s/deployment.yaml",
      "service": "k8s/service.yaml",
      "migrationJob": "k8s/migration-job.yaml",
      "secretApp": "k8s/secret-app-template.yaml",
      "secretMigration": "k8s/secret-migration-template.yaml"
    }
  },
  "secrets": {
    "runtimeDatabase": "/oficina/estoque/runtime-db",
    "migrationDatabase": "/oficina/estoque/migration-db"
  },
  "queues": {
    "commandsUrlParameter": "/oficina/infra/sqs/estoque-comandos/url",
    "commandsArnParameter": "/oficina/infra/sqs/estoque-comandos/arn",
    "commandsDlqUrlParameter": "/oficina/infra/sqs/estoque-comandos-dlq/url",
    "commandsDlqArnParameter": "/oficina/infra/sqs/estoque-comandos-dlq/arn",
    "eventsUrlParameter": "/oficina/infra/sqs/ordens-eventos/url",
    "eventsArnParameter": "/oficina/infra/sqs/ordens-eventos/arn",
    "eventsDlqUrlParameter": "/oficina/infra/sqs/ordens-eventos-dlq/url",
    "eventsDlqArnParameter": "/oficina/infra/sqs/ordens-eventos-dlq/arn",
    "consumerConcurrency": 1,
    "maxMessagesPerReceive": 1,
    "waitTimeSeconds": 20,
    "visibilityTimeoutSeconds": 60
  },
  "health": {
    "path": "/health",
    "readinessPath": "/ready",
    "initialDelaySeconds": 10,
    "periodSeconds": 10,
    "timeoutSeconds": 3,
    "failureThreshold": 6
  },
  "deployment": {
    "progressDeadlineSeconds": 600,
    "terminationGracePeriodSeconds": 30
  },
  "deploy": {
    "s3Prefix": "k8s-deploy/estoque/",
    "parameterPathPrefix": "/oficina/deploy/estoque/",
    "presignedUrlTtlSeconds": 300,
    "maxManifestBytes": 30000,
    "rolloutTimeoutSeconds": 600,
    "migrationTimeoutSeconds": 900
  },
  "coverage": {
    "minimumLinePercentage": 80
  }
}
